# ADP credentials
ADP_USER=your_adp_user
ADP_PASSWORD=your_adp_password

# Ano para começar a extração; usa ano passado se omitido
ADP_SINCE=2025

# Roda o Chromium em modo headless (sem mostrar a janela); só que não funciona
HEADLESS=false

# Pasta onde gravar resultados
OUTPUT=extração

# Grava PDFs de todos os demonstrativos
PDF=true

# Grava arquivo pickle de toda a extração
PICKLE=true

# Mostra algumas coisas a mais
DEBUG=false
